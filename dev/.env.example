# Copy to dev/.env and adjust. Normally you do not: `scripts/db/db up` generates
# dev/.env with random local credentials (mode 600, gitignored) on first run.
#
# Values are deliberately EMPTY rather than convenient guesses. A committed default
# password is the one thing that reliably escapes a development directory, because it
# reads as "already configured" and gets copied into a deployment. The tooling refuses
# to start with an unset password, so an empty file here fails loudly instead of
# silently working against a real server.
#
# Every name below is read by scripts/db/_common.sh or scripts/db/init.sh. There is no
# PGHOST: connections are made inside the container over its local socket, and over the
# network only by the documented audit command in dev/README.md.

# What the published port binds to. 127.0.0.1 keeps the database to this machine;
# 0.0.0.0 exposes it to the network, which scripts/db/init.sh only does after it has
# installed TLS and the hostssl-only pg_hba rules. Never use 0.0.0.0 on a host with
# public IPv6 on the interface unless that is what you intend.
PGBIND=127.0.0.1
PGPORT=5432

# Superuser. DDL and migrations only - agents never connect as this role, because the
# table owner bypasses ROW LEVEL SECURITY even when it is enabled (DATABASE_REVIEW.md
# 5.7), which would make every isolation test in the harness a false pass.
POSTGRES_PASSWORD=

# Non-owner agent runtime role: DML and EXECUTE, no DDL.
AFPC_APP_PASSWORD=

# CAO/validation role: SELECT only, read-only enforced at role level.
AFPC_READONLY_PASSWORD=

# Human audit account. SELECT on every current and future table in public, with
# default_transaction_read_only and log_statement=all set per role, so the audit has an
# audit trail. Connect with the recipe in dev/README.md using dev/tls/afpc-ca.crt.
AFPC_AUDITOR_PASSWORD=

# The single development tenant, created by db/migrations/0003_tenant_foundation.sql.
# Keep this value in step with the migration: it is also what app.default_tenant_id
# resolves to on a connection that has not set app.tenant_id.
AFPC_TENANT_ID=00000000-0000-0000-0000-000000000001
